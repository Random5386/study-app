// The database, described as code. See docs/05-database-prisma.md.
// Change it, then run `npm run db:migrate -- --name <what_changed>` from the repo root.
// Phase 2 added accounts and security; phase 3 adds the study guide library.
// Notes, decks and flashcards come in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // the connection URL lives in prisma.config.ts
}

// ---------------------------------------------------------------------------
// Accounts and security (phase 2). See docs/06 and docs/07.
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique // always stored lower-case
  displayName     String
  passwordHash    String // argon2id hash, never the password itself
  emailVerifiedAt DateTime?
  totpSecretEnc   String? // TOTP secret, encrypted with AES-256-GCM
  totpLastStep    Int? // last accepted 30-second step, so a code can't be replayed
  mfaEnabledAt    DateTime? // null = MFA off
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  aiDailyQuota    Int       @default(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recoveryCodes RecoveryCode[]
  authTokens    AuthToken[]
  loginSessions LoginSession[]
  auditLogs     AuditLog[]
  subjects      Subject[]
  documents     Document[]
  tags          Tag[]
}

/// One-time MFA backup codes. Only SHA-256 hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Links emailed to the user (verify email, reset password). Only hashes are stored.
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Server-side sessions, read and written by connect-pg-simple (the table layout it expects).
model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

/// One row per signed-in device, for the "active sessions" page.
model LoginSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sid        String   @unique // the express-session id
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

enum AuditEvent {
  REGISTERED
  EMAIL_VERIFIED
  LOGIN
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  MFA_ENABLED
  MFA_DISABLED
  MFA_FAILED
  RECOVERY_CODE_USED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  SESSIONS_REVOKED
}

/// Security history shown to the user on the Security page.
model AuditLog {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     AuditEvent
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Study guide library (phase 3). See docs/09-file-uploads.md.
// ---------------------------------------------------------------------------

/// A folder for study material, e.g. "Biology 101".
model Subject {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colour    String     @default("indigo")
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]

  @@unique([userId, name]) // no two subjects with the same name for one user
}

enum DocumentStatus {
  PROCESSING // uploaded, text extraction queued or running
  READY // text extracted
  FAILED // couldn't extract text (e.g. a scanned PDF)
}

/// An uploaded study guide. The file bytes live in DocumentFile so lists stay fast.
model Document {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId     String?        @db.Uuid
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull) // deleting a subject keeps its documents
  title         String
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String // fingerprint of the file, used to spot duplicates
  status        DocumentStatus @default(PROCESSING)
  failureReason String?
  extractedText String?
  pageCount     Int?
  wordCount     Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  file          DocumentFile?
  tags          DocumentTag[]

  @@unique([userId, sha256]) // the same file uploaded twice is stored once
  @@index([userId, subjectId])
  @@index([userId, createdAt])
}

/// The uploaded file itself (one-to-one with Document).
model DocumentFile {
  documentId String   @id @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  bytes      Bytes
}

model Tag {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime      @default(now())
  documents DocumentTag[]

  @@unique([userId, name])
}

/// Join table: which tags are on which documents (many-to-many).
model DocumentTag {
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String   @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}
