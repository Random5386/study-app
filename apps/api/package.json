{
  "name": "@studyapp/api",
  "version": "0.1.0",
  "private": true,
  "description": "StudyApp back end: Node.js + Express 5 + Prisma",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --conditions=development prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@studyapp/shared": "0.1.0",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
