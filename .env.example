# Copy this file to .env (or run `npm run setup`, which also fills in the secrets for you).
# .env is git-ignored. Never commit real secrets.

APP_NAME=StudyApp
# Where the React app runs in development (Vite)
APP_URL=http://localhost:5173
# Port the Express API listens on
PORT=3000

# Local PostgreSQL started by `docker compose up -d` (local-only password, never reuse it)
DATABASE_URL=postgresql://studyapp:studyapp_dev_password@localhost:5432/studyapp
TEST_DATABASE_URL=postgresql://studyapp:studyapp_dev_password@localhost:5432/studyapp_test

# Random secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (SESSION_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (ENCRYPTION_KEY, 64 hex chars)
SESSION_SECRET=
ENCRYPTION_KEY=

# Free key from https://aistudio.google.com/apikey in a Google project with NO billing account
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
AI_DAILY_QUOTA=20

# Mailpit (local fake email server from docker-compose). Inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Log detail: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
